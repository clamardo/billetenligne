# Dart / Flutter
.dart_tool/
build/
.packages
.flutter-plugins
.flutter-plugins-dependencies
*.iml

# Local dev secrets and emulator state (ADR-0020)
infra/dev/.env
infra/dev/firebase-data/data/*
!infra/dev/firebase-data/data/.gitignore

# Editors
.idea/
*.swp
.DS_Store

# The debug configuration is shared, personal editor settings are not. A
# launch config that every developer rewrites from a README is a launch config
# that is wrong on somebody's machine on a Tuesday.
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Dart Frog's generated route table. Written by `tool/frog_routes.sh` and by
# `dart_frog dev`; committing generated code is committing something somebody
# will edit by mistake.
services/api/.dart_frog/

# Copied from packages/bel_localization/i18n by tool/sync_i18n.sh. Generated,
# not authored — and a committed copy is a copy somebody will edit by mistake.
apps/*/assets/i18n/

# Terraform: state, providers, and the one file that holds real project ids
# and passwords. The `.sample.json` next to it is what is committed.
terraform/**/.terraform/
terraform/**/.terraform.lock.hcl
terraform/**/*.tfstate
terraform/**/*.tfstate.*
terraform/credentials-*.json
!terraform/credentials-*.sample.json
