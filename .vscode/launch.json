{
  // Run the whole product on one machine, with breakpoints.
  //
  // Nothing here needs a cloud account, a telco credential or a network: the
  // stack is four containers, the payment rails are fakes that can produce
  // every terminal state, and Firebase is the emulator on a `demo-` project
  // (ADR-0020). The two handset apps additionally run with **no server at
  // all** — the demo configurations below — which is how a screen gets
  // reviewed by somebody who is not set up to run Postgres.
  //
  // Start with the compound **"Everything (API + worker + traveller)"**.
  "version": "0.2.0",
  "configurations": [
    {
      // The generated route table, not `build/` — see the "api: routes" task
      // for why a breakpoint only binds against one of the two.
      "name": "API",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/services/api/.dart_frog/server.dart",
      "cwd": "${workspaceFolder}/services/api",
      "preLaunchTask": "api: routes",
      "envFile": "${workspaceFolder}/infra/dev/.env",
      "env": {
        "PORT": "8080",
        // Read from disk at composition time, and the API's working directory
        // is its own package rather than the repo root.
        "BEL_I18N_DIR": "${workspaceFolder}/packages/bel_localization/i18n"
      }
    },
    {
      // Every pass, once, then exit — the shape it deploys in. Run it whenever
      // you want a queued message to actually be sent, a lapsed hold to be
      // released, or a payment to be reconciled.
      "name": "Worker — every pass",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/services/worker/bin/worker.dart",
      "cwd": "${workspaceFolder}/services/worker",
      "preLaunchTask": "dev: migrate",
      "envFile": "${workspaceFolder}/infra/dev/.env",
      "env": {
        "BEL_I18N_DIR": "${workspaceFolder}/packages/bel_localization/i18n"
      }
    },
    {
      // The drain alone. With no ACS connection string every message is
      // written to this console, sign-in codes included — which is how you
      // sign in locally.
      "name": "Worker — outbox drain only",
      // The drain reads `DATABASE_URL` like every other pass, and without a
      // pre-launch task nothing else would have created the file it comes
      // from. The migrate step is deliberately absent: this configuration
      // exists to watch one pass, not to touch the schema.
      "preLaunchTask": "dev: env",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/services/worker/bin/worker.dart",
      "cwd": "${workspaceFolder}/services/worker",
      "args": ["outbox"],
      "envFile": "${workspaceFolder}/infra/dev/.env",
      "env": {
        "BEL_I18N_DIR": "${workspaceFolder}/packages/bel_localization/i18n"
      }
    },
    {
      "name": "Traveller — demo data, no server",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/traveller/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/traveller",
      "preLaunchTask": "apps: i18n"
    },
    {
      // One config, right on every device. There used to be a second one
      // saying `10.0.2.2` — the host machine as seen from inside the Android
      // emulator, where `localhost` is the emulator itself and a request to
      // it hangs rather than fails. Picking the wrong one of two configs
      // presents as a spinner that never stops, so the app now resolves the
      // host itself (`_reachable` in main.dart) and there is one to pick.
      "name": "Traveller — local API",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/traveller/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/traveller",
      "preLaunchTask": "apps: i18n",
      "toolArgs": [
        "--dart-define=BEL_API_URL=http://localhost:8080",
        "--dart-define=BEL_FIREBASE_EMULATOR=localhost:9099"
      ]
    },
    {
      "name": "Scanner — signed demo departure, no server",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/scanner/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/scanner",
      "preLaunchTask": "apps: i18n"
    },
    {
      // A fixed device id, so the boarding log a killed app picks up again is
      // the one this run wrote — and so two runs on one machine do not look
      // like two conductors at one door.
      "name": "Scanner — local API",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/scanner/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/scanner",
      "preLaunchTask": "apps: i18n",
      "toolArgs": [
        "--dart-define=BEL_API_URL=http://localhost:8080",
        "--dart-define=BEL_FIREBASE_EMULATOR=localhost:9099",
        "--dart-define=BEL_DEVICE_ID=scanner-dev"
      ]
    },
    {
      // The console and the back office have **no demo mode on purpose**: an
      // operator surface that invents its own tenant teaches the opposite of
      // what the surface is for. Both default to `localhost:8080` and the
      // Auth emulator with no defines at all.
      // `chrome` opens a browser window itself. The pinned port is what makes
      // the address worth writing down: without it Flutter picks a fresh one
      // every run, so the tab you left open yesterday is pointing at nothing
      // and the URL cannot go in a bookmark or a bug report.
      "name": "Console (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/console/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/console",
      "preLaunchTask": "apps: i18n",
      "deviceId": "chrome",
      "toolArgs": ["--web-port=5000", "--web-hostname=localhost"]
    },
    {
      // http://localhost:5001, for the same reason as above.
      "name": "Admin back office (Chrome)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/admin/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/admin",
      "preLaunchTask": "apps: i18n",
      "deviceId": "chrome",
      "toolArgs": ["--web-port=5001", "--web-hostname=localhost"]
    }
  ],
  "compounds": [
    {
      // The one to press first, and it means it: containers, schema, the demo
      // world, a handset, then every surface this product has. Nothing to
      // choose and nothing else to start.
      //
      // The traveller and the scanner share one emulator, so the second to
      // launch comes up in front — both are installed, and the launcher
      // switches between them.
      "name": "Everything",
      "configurations": [
        "API",
        "Worker — outbox drain only",
        "Console (Chrome)",
        "Admin back office (Chrome)",
        "Traveller — local API",
        "Scanner — local API"
      ],
      "preLaunchTask": "dev: everything ready",
      "stopAll": true
    },
    {
      // The narrower loop, for when the console and the back office are not
      // what is being worked on.
      "name": "Traveller loop (API + worker + traveller)",
      "configurations": [
        "API",
        "Worker — outbox drain only",
        "Traveller — local API"
      ],
      "preLaunchTask": "dev: everything ready",
      "stopAll": true
    },
    {
      "name": "Back office (API + worker + console + admin)",
      "configurations": [
        "API",
        "Worker — outbox drain only",
        "Console (Chrome)",
        "Admin back office (Chrome)"
      ],
      "preLaunchTask": "dev: seed demo world",
      "stopAll": true
    },
    {
      "name": "The door (API + worker + scanner)",
      "configurations": [
        "API",
        "Worker — outbox drain only",
        "Scanner — local API"
      ],
      "preLaunchTask": "dev: seed demo world",
      "stopAll": true
    },
    {
      // No containers, no server, no schema: both handset apps on their demo
      // gateways. This is the configuration that works on an aeroplane.
      "name": "Demo only (traveller + scanner, no server)",
      "configurations": [
        "Traveller — demo data, no server",
        "Scanner — signed demo departure, no server"
      ],
      "stopAll": true
    }
  ]
}
