<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Universal Links (ADR-0026). The app's half of the handshake; the
	     domain's half is served at /.well-known/apple-app-site-association.

	     Attached to the Runner target by CODE_SIGN_ENTITLEMENTS in all three
	     build configurations. It was not, for as long as this file has
	     existed: an entitlements file Xcode never reads is a Universal Links
	     claim that is made nowhere, and nothing about it is visible until
	     somebody taps a ticket link on an iPhone and gets Safari.

	     Still unsigned and still unbuilt — there is no Mac and no Apple team
	     for this deployment — so `applinks:blt.cg` is declared by the app and
	     by the domain and verified by neither. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:blt.cg</string>
	</array>
</dict>
</plist>
