# BilletEnLigne — local development (ADR-0020).
# Copy to `.env`. Every value here is safe to commit; `.env` itself is not.
#
# **The API and the worker find this file themselves.** Every launcher has its
# own way of getting these into a process — `tool/api_dev.sh` sources it, VS
# Code has `envFile`, `dart run` has nothing — and when one of them quietly
# does not work the API does not fail: it falls back to the in-memory
# composition, answers 200, serves invented departures and writes the sign-in
# code to its own stdout. So the process looks for `infra/dev/.env` when
# `DATABASE_URL` is unset, and says on startup that it did.
#
# A variable already in the environment always wins. `BEL_ENV_FILE=none`
# turns the search off (what `tool/smoke_api.sh` does, because it exercises
# the fakes composition on purpose) and `BEL_ENV_FILE=<path>` points it
# elsewhere.
#
# `curl localhost:8080/health` reports what the process is actually wired to:
#   {"data":"postgres","mail":"smtp","storage":"objects"}
# `"data":"fakes"` or `"mail":"log"` means this file did not reach it.

# ---------------------------------------------------------------------------
# Firebase Authentication (ADR-0018)
# The `demo-` prefix is what makes the emulator run fully offline. A project id
# without it can reach the real cloud — there is a test asserting production
# config never carries `demo-`.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-billetenligne
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Set to "" to disable emulator import/export (what a test run does).
# FIREBASE_PERSISTENCE=

# Service-account credentials, for signing custom tokens in a real environment.
# UNSET LOCALLY AND THAT IS THE POINT: the emulator does not check the
# signature on a custom token, which is what makes a credential-free local loop
# possible. The API refuses to sign with a real key while the emulator host is
# set, so these two blocks cannot be half-configured into something dangerous.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Azure Communication Services (ADR-0019)
#
# BLANK IS A SUPPORTED STATE and it is the default. With no connection string
# the API falls back to the logging sender and writes BOTH SMS and email to its
# own stdout — including the sign-in code, which is how you sign in locally.
# Nobody's handset or inbox receives anything from your laptop, and no test run
# costs money.
#
# Mailpit (http://localhost:8025) is in the stack for the operator
# correspondence that will come later; nothing routes to it yet.
#
# To exercise real delivery, paste the shared development connection string
# here — never commit it. A dedicated BilletEnLigne ACS resource replaces the
# shared one before any real traffic.
# ---------------------------------------------------------------------------
COMMS__CONNECTIONSTRING=
COMMS__SMSFROM=
COMMS__EMAILFROM=no-reply@billetenligne.local

# Local email transport, for when something routes to Mailpit.
# Mailpit, from the dev compose stack. Read by the API and by the worker, and
# chosen only when COMMS__CONNECTIONSTRING above is blank — so a deployment
# with a real ACS string can never be diverted into a mail catcher.
#
# With it set, a sign-in code, a ticket link and an operator statement all
# land in http://localhost:8025 as readable messages with their attachments,
# rather than as a line of log saying a PDF existed. SMS has no equivalent and
# keeps going to the log, which is where a developer reads it anyway.
SMTP__HOST=localhost
SMTP__PORT=1025

# ---------------------------------------------------------------------------
# Sign-in codes (ADR-0013, ADR-0018)
#
# Keys the HMAC that stands in for a stored code — the challenge table holds a
# digest, never a code, so a dump of it lets nobody sign in as anybody.
#
# Unset in a real environment, the API generates one per process and says so
# loudly: codes then stop verifying across a restart and across instances.
# That is deliberate. A constant default would mean a leaked repository could
# forge codes forever, and this failure is at least impossible to ignore.
# ---------------------------------------------------------------------------
AUTH_CODE_KEY=development-only-sign-in-code-key-32ch

# ---------------------------------------------------------------------------
# Second-factor seeds at rest (ADR-0013)
#
# A TOTP seed is the one secret here the server has to be able to *read* — it
# recomputes a code from it every thirty seconds — so it is encrypted rather
# than hashed. What that buys is separation: a copy of the database without
# this variable is a copy nobody can enrol from. It does not defend against
# somebody who has the environment, and claiming otherwise would be worse than
# the gap.
#
# UNSET IS SUPPORTED AND LOUD: seeds are then stored in the clear and the API
# says so at startup. It is set here so the local loop exercises the real path.
#
# Not a key you can change casually. A sealed row that will not open is an
# error rather than a missing factor, because a factor that quietly reads as
# absent is a factor an attacker can re-enrol.
# ---------------------------------------------------------------------------
TOTP__ENCRYPTIONKEY=development-only-totp-seed-key-32ch

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# bel_api, not bel_app. bel_api is NOINHERIT and a member of all four surface
# roles, so a borrowed connection holds no privileges until a transaction
# declares which surface it is serving with SET LOCAL ROLE (migration 0005).
# Connecting as bel_app instead cannot reach the traveller or identity
# surfaces at all — the first sign-in would fail on a permission error.
# `sslmode=disable` is not optional here, and leaving it off does not produce
# an error you can read: the driver defaults to requiring TLS, the dev
# Postgres does not offer it, and the pool retries the refused handshake — so
# the API answers nothing and the worker hangs on its first pass rather than
# saying "the server does not support SSL". Every script that builds its own
# URL (`tool/demo.sh`, `tool/integration.sh`) already appends it.
DATABASE_URL=postgres://bel_api:bel_api@localhost:5432/billetenligne?sslmode=disable

# The seed connection. Owns the schema, crosses the tenancy boundary that
# application code is forbidden to cross, and is used by the migration runner
# and the demo world — never by the API.
SEED_DATABASE_URL=postgres://bel:bel@localhost:5432/billetenligne?sslmode=disable

# ---------------------------------------------------------------------------
# Object storage — where a logo and a cover live (ADR-0026)
#
# Azurite, from the dev compose stack, with the well-known development account
# and key. They are public, identical on every machine and already hardcoded in
# `tool/storage.sh`; they are written out here rather than referenced so a
# fresh clone can upload a logo without a setup step.
#
# BLANK IS SUPPORTED and it is *not* what you want locally: with no account
# the API substitutes an in-memory store, `/health` says so, and the vitrine's
# logo and cover pickers work until the process restarts. That state exists for
# a unit run, not for a person clicking around.
#
# The container is created on first write, so there is nothing to provision.
# `STORAGE__ENDPOINT` must carry the account path segment — Azurite routes by
# it, real Azure does not.
# ---------------------------------------------------------------------------
STORAGE__ACCOUNT=devstoreaccount1
STORAGE__KEY=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==
STORAGE__ENDPOINT=http://127.0.0.1:10000/devstoreaccount1
STORAGE__CONTAINER=brand

# ---------------------------------------------------------------------------
# Payments (ADR-0005, ADR-0006)
# No rail has real credentials locally. The fake gateway can produce every
# terminal state plus lost/duplicate/out-of-order callbacks — that matrix is
# what makes a rail production-ready (ADR-0021 layer 3).
# ---------------------------------------------------------------------------
# A rail with blank credentials is not registered at all, which is why these
# are listed and left empty: an unset rail is absent from the checkout rather
# than present and answering 502. The base URLs each default to the rail's
# sandbox and are deliberately not written here — an empty value would beat
# the default and point the client at nothing.
#
#   MTN__BASEURL / MTN__TARGETENVIRONMENT
#   AIRTEL__BASEURL
#   ORANGE__BASEURL / ORANGE__COUNTRY   (country defaults to the market's)
#   CARD__BASEURL
AIRTEL__CLIENTID=
AIRTEL__CLIENTSECRET=
MTN__SUBSCRIPTIONKEY=
MTN__APIUSER=
MTN__APIKEY=
ORANGE__CLIENTID=
ORANGE__CLIENTSECRET=
ORANGE__MERCHANTKEY=

# The card rail has two shapes. `CARD__SANDBOX` non-empty selects the PSP's
# test tenancy without credentials; `CARD__APIKEY` plus `CARD__SITEID` selects
# the real one. Both blank means no card at checkout, which is the local
# default and the honest one until a PSP account exists.
CARD__SANDBOX=
CARD__APIKEY=
CARD__SITEID=

# Money going the OTHER way — refunds sent back to a wallet.
#
# A separate product on every rail here, and the separation is not
# bureaucratic: it is a separately funded float that somebody has to top up.
# Configuring collections must not appear to configure payouts, which is why
# these are their own variables and why leaving them blank means refunds go to
# an agency counter rather than half-working.
#
# MTN issues a second subscription key for Disbursements, and usually a second
# API user; the collection key here is a 401 on every call. The two fallbacks
# exist because some sandbox tenancies do share the user.
MTN__DISBURSEMENTKEY=
MTN__DISBURSEMENTUSER=
MTN__DISBURSEMENTAPIKEY=

# Airtel shares its OAuth credentials between collections and disbursements,
# so the PIN is what gates the payout rail. It is the merchant wallet PIN,
# **already RSA-encrypted** under Airtel's public key: the plaintext is the one
# credential that authorises money leaving, and a process that never holds it
# cannot leak it in a heap dump or a core file.
AIRTEL__DISBURSEMENTPIN=

# Orange Money has no disbursement API in the Web Payment product, and a card
# refund would go back to a PAN this system has never seen. Both are refunded
# at a counter, and there is deliberately no variable here to suggest
# otherwise.

# ---------------------------------------------------------------------------
# Ticket signing (ADR-0007)
#
# No variable, on purpose. Outside a real deployment the issuer uses a fixed
# development Ed25519 seed compiled into `Ed25519TicketIssuer.development()`,
# so a ticket signed by yesterday's run still verifies today and a scanner
# built from this repo trusts it. Production keys come from KMS and never pass
# through a file like this one.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Test runs (ADR-0020 rule 3)
#
#   docker compose --profile test up -d
#
# brings up `postgres-test` on tmpfs alongside the ordinary stack. Add
# `FIREBASE_PERSISTENCE=` above to stop the emulator importing and exporting
# accounts between runs. A suite starts from a known world or it is not a
# suite.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Where this deployment answers (ADR-0014, ADR-0026)
#
# `PUBLIC_BASE_URL` is the origin a *rail* calls back on, so it has to be an
# address the rail can reach. localhost is right for the fake gateway and
# wrong for a sandbox on the internet; point it at a tunnel when exercising
# one for real.
#
# `BEL__SHAREBASEURL` is the origin printed on a share link and a ticket link
# (`/t/<token>`, `/b/<ref>`). It is blt.cg in production and the local API
# here, so a link a local run puts in Mailpit is a link that opens.
# ---------------------------------------------------------------------------
PUBLIC_BASE_URL=http://localhost:8080
BEL__SHAREBASEURL=http://localhost:8080

# Approves seeded demo companies automatically so the console has an operator
# to sign into. It clears **seeded companies only** — the marker is written by
# the demo seeder — so this surviving into a deployment approves nobody.
BEL__SCREENING=demo

# App-link claims, served at /.well-known. The defaults are this repo's own
# package name and an empty fingerprint list, which is correct until there is
# a signed build to claim.
#
#   BEL__ANDROIDPACKAGE / BEL__ANDROIDFINGERPRINTS / BEL__APPLEAPPID

# Where the landing page at `/` sends somebody. Blank is the supported state
# and it changes what the page says: with no store URL it tells the reader the
# app is not published yet, rather than showing a button that goes nowhere.
# Set them the day the listings exist, and no code changes.
#
#   BEL__PLAYSTOREURL / BEL__APPSTOREURL
#
# And where the operator console answers, for the one card on that page aimed
# at a coach company rather than a passenger. Left blank here because a local
# console is `flutter run -d chrome` on a port that moves.
#
#   BEL__CONSOLEURL

# How many sign-in codes one IP may ask for per hour. Defaults to a production
# figure; raise it when a demo hands the same laptop to twenty people.
#
#   BEL_SIGNIN_MAX_PER_SOURCE
