# BilletEnLigne — local development (ADR-0020).
# Copy to `.env`. Every value here is safe to commit; `.env` itself is not.

# ---------------------------------------------------------------------------
# Firebase Authentication (ADR-0018)
# The `demo-` prefix is what makes the emulator run fully offline. A project id
# without it can reach the real cloud — there is a test asserting production
# config never carries `demo-`.
# ---------------------------------------------------------------------------
FIREBASE_PROJECT_ID=demo-billetenligne
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Set to "" to disable emulator import/export (what a test run does).
# FIREBASE_PERSISTENCE=

# Service-account credentials, for signing custom tokens in a real environment.
# UNSET LOCALLY AND THAT IS THE POINT: the emulator does not check the
# signature on a custom token, which is what makes a credential-free local loop
# possible. The API refuses to sign with a real key while the emulator host is
# set, so these two blocks cannot be half-configured into something dangerous.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Azure Communication Services (ADR-0019)
#
# BLANK IS A SUPPORTED STATE and it is the default. With no connection string
# the API falls back to the logging sender and writes BOTH SMS and email to its
# own stdout — including the sign-in code, which is how you sign in locally.
# Nobody's handset or inbox receives anything from your laptop, and no test run
# costs money.
#
# Mailpit (http://localhost:8025) is in the stack for the operator
# correspondence that will come later; nothing routes to it yet.
#
# To exercise real delivery, paste the shared development connection string
# here — never commit it. A dedicated BilletEnLigne ACS resource replaces the
# shared one before any real traffic.
# ---------------------------------------------------------------------------
COMMS__CONNECTIONSTRING=
COMMS__SMSFROM=
COMMS__EMAILFROM=no-reply@billetenligne.local

# Local email transport, for when something routes to Mailpit.
SMTP__HOST=localhost
SMTP__PORT=1025

# ---------------------------------------------------------------------------
# Sign-in codes (ADR-0013, ADR-0018)
#
# Keys the HMAC that stands in for a stored code — the challenge table holds a
# digest, never a code, so a dump of it lets nobody sign in as anybody.
#
# Unset in a real environment, the API generates one per process and says so
# loudly: codes then stop verifying across a restart and across instances.
# That is deliberate. A constant default would mean a leaked repository could
# forge codes forever, and this failure is at least impossible to ignore.
# ---------------------------------------------------------------------------
AUTH_CODE_KEY=development-only-sign-in-code-key-32ch

# ---------------------------------------------------------------------------
# Second-factor seeds at rest (ADR-0013)
#
# A TOTP seed is the one secret here the server has to be able to *read* — it
# recomputes a code from it every thirty seconds — so it is encrypted rather
# than hashed. What that buys is separation: a copy of the database without
# this variable is a copy nobody can enrol from. It does not defend against
# somebody who has the environment, and claiming otherwise would be worse than
# the gap.
#
# UNSET IS SUPPORTED AND LOUD: seeds are then stored in the clear and the API
# says so at startup. It is set here so the local loop exercises the real path.
#
# Not a key you can change casually. A sealed row that will not open is an
# error rather than a missing factor, because a factor that quietly reads as
# absent is a factor an attacker can re-enrol.
# ---------------------------------------------------------------------------
TOTP__ENCRYPTIONKEY=development-only-totp-seed-key-32ch

# ---------------------------------------------------------------------------
# Datastores
# ---------------------------------------------------------------------------
# bel_api, not bel_app. bel_api is NOINHERIT and a member of all four surface
# roles, so a borrowed connection holds no privileges until a transaction
# declares which surface it is serving with SET LOCAL ROLE (migration 0005).
# Connecting as bel_app instead cannot reach the traveller or identity
# surfaces at all — the first sign-in would fail on a permission error.
DATABASE_URL=postgres://bel_api:bel_api@localhost:5432/billetenligne
DATABASE_ADMIN_URL=postgres://bel_admin:bel_admin@localhost:5432/billetenligne
AZURITE_CONNECTION_STRING=UseDevelopmentStorage=true;

# ---------------------------------------------------------------------------
# Payments (ADR-0005, ADR-0006)
# No rail has real credentials locally. The fake gateway can produce every
# terminal state plus lost/duplicate/out-of-order callbacks — that matrix is
# what makes a rail production-ready (ADR-0021 layer 3).
# ---------------------------------------------------------------------------
PAYMENTS__DEFAULTGATEWAY=fake
AIRTEL__CLIENTID=
AIRTEL__CLIENTSECRET=
MTN__SUBSCRIPTIONKEY=
MTN__APIUSER=
MTN__APIKEY=

# ---------------------------------------------------------------------------
# Ticket signing (ADR-0007)
# A fixed local Ed25519 keypair, so a ticket signed by yesterday's run still
# verifies today. Production keys live in KMS and never touch a repository.
# ---------------------------------------------------------------------------
TICKETS__SIGNINGKEY=dev-ed25519-seed-do-not-use-in-production
TICKETS__KEYID=1

# ---------------------------------------------------------------------------
# Test runs (ADR-0020 rule 3)
# true => Postgres on tmpfs, no Azurite volume, no Firebase import/export.
# A suite starts from a known world or it is not a suite.
# ---------------------------------------------------------------------------
BEL_TEST_RUN=false

# ---------------------------------------------------------------------------
# Maps (ADR-0014). Unset locally: the follower page falls back to the
# tier-3 progress bar, which is a state that must be tested anyway.
# ---------------------------------------------------------------------------
MAPS__APIKEY=
